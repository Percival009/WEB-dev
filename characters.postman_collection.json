{
  "info": {
    "name": "Character API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:4000/api"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{base}}/users/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"demo{{run}}\",\n  \"email\": \"demo{{run}}@example.com\",\n  \"password\": \"demo-pass\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('run', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{base}}/users/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo{{run}}@example.com\",\n  \"password\": \"demo-pass\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create character",
      "request": {
        "method": "POST",
        "url": "{{base}}/posts",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mira\",\n  \"description\": \"A mountain guide\",\n  \"age\": 22\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read characters",
      "request": {
        "method": "GET",
        "url": "{{base}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update character",
      "request": {
        "method": "PATCH",
        "url": "{{base}}/posts/{{id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 23\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Age changed', () => pm.expect(pm.response.json().age).to.equal(23));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete character",
      "request": {
        "method": "DELETE",
        "url": "{{base}}/posts/{{id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{base}}/users/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expected HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
